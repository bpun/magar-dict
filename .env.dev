# ===========================================================================
# Magar Dictionary: environment configuration template
#
# Copy to .env for local development:   cp .env.example .env
# NEVER commit .env. In production, set these in the hosting platform's
# secret store (Render or Fly.io dashboard), not in files.
# ===========================================================================

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME=Magar Dictionary
DEBUG=true                          # must be false in staging and production
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000

# --- Database (PostgreSQL 16) -----------------------------------------------
DATABASE_URL=postgresql+psycopg://magar:magar_dev_password@localhost:5432/magar
# Local tests may use SQLite instead:
# DATABASE_URL=sqlite:///./data/test.sqlite3

# --- Redis (login lockout, AI quotas, caching) ------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Authentication ---------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=10
EMAIL_VERIFICATION_HOURS=24

# --- Email (verification and password reset) --------------------------------
EMAIL_PROVIDER=console              # console (dev) | postmark | ses | resend
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
POSTMARK_API_TOKEN=

# --- AI features ------------------------------------------------------------
LLM_PROVIDER=openai                 # openai | anthropic (see OD-2)
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
AI_DAILY_QUOTA_LEARNER=20
AI_CACHE_TTL_HOURS=720
PROMPT_VERSION=v1

# --- Semantic search (installed from Day 17) --------------------------------
EMBEDDING_MODEL=sentence-transformers/LaBSE
FAISS_INDEX_VERSION=latest          # e.g. index_v2026-06-01; set to roll back
SEARCH_DEFAULT_MODE=hybrid          # keyword | fuzzy | semantic | hybrid
SEARCH_CACHE_TTL_SECONDS=600

# --- Speech and audio -------------------------------------------------------
TTS_PROVIDER=gtts                   # gtts (dev) | coqui (prod)
AUDIO_STORAGE=local                 # local (dev) | s3 (prod)
AUDIO_LOCAL_DIR=app/static/audio
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300

# --- Rate limits ------------------------------------------------------------
RATE_LIMIT_SEARCH=60/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/hour
RATE_LIMIT_AI=20/day

# --- Observability ----------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Dialects (fixed list; changing these requires a migration) -------------
DIALECT_SLUGS=dhut,kham,kaike
